. env.sh


#if partiton exists
if [ -b  $LFS_PARTITION ] || [ -f $LFS_PARTITION ]
then

mount $LFS_PARTITION builddir

else

echo "Error: Target partition/file is not found"
exit

fi



mkdir -v $LFS/sources
chmod -v a+wt $LFS/sources


if [[ "$SOURCESDISK" != "" ]]
then

if [[ "$FORMATSOURCESDISK" == "YES" ]]
then

mkfs.ext4 -F $SOURCESDISK

fi

mount $SOURCESDISK builddir/sources

fi



./chrootmount
./copysrc
./runchrootscripts
./deletesrc
./chrootumount


if [[ "$SOURCESDISK" != "" ]]
then

umount $SOURCESDISK

fi

./finish

#copy customizer log
mkdir -p builddir/var/log/lfscustomizer
cp -rv log/* builddir/var/log/lfscustomizer
